    "keyMessages": [
      {
        "id": "projects-400",
        "label": "400+ completed projects",
        "pattern": "400\\+?\\s*(completed\\s+)?(projects|homes)"
      },
      {
        "id": "founded-2007",
        "label": "Founded in Seattle in 2007",
        "pattern": "(founded|established|since|launched)\\s*(in\\s*)?2007"
      },
      {
        "id": "architect-designed",
        "label": "Architect-designed, with architects and engineers in one process",
        "pattern": "architect[- ]?(designed|led|driven)|architects? and engineers"
      },
      {
        "id": "factory-built",
        "label": "Built indoors in a factory, then delivered and set on site",
        "pattern": "built indoors|factory[- ]?built|in a (controlled )?factory|off[- ]?site (construction|built)"
      },
      {
        "id": "sustainable",
        "label": "Sustainable: Passive House, LEED, net-zero, Energy Star ready",
        "pattern": "passive house|\\bleed\\b|net[- ]?zero|energy star|sustainab"
      },
      {
        "id": "predesigned-and-custom",
        "label": "Predesigned series plus fully custom homes",
        "pattern": "pre-?designed|predesigned|(series|models?).{0,40}custom|custom.{0,40}(series|pre-?designed)"
      }
    ],
    "gates": {
      "technical": {
        "2": [
          {
            "check": "metadata-coverage",
            "min": 0.8,
            "label": "title + description + H1 on 80% of key pages"
          }
        ],
        "4": [
          {
            "check": "schema-type",
            "min": 0.9,
            "label": "page-typed schema on 90% of pages"
          }
        ]
      },
      "content": {
        "2": [
          {
            "check": "depth",
            "min": 0.6,
            "label": "key pages past the 300-word threshold"
          }
        ],
        "4": [
          {
            "check": "freshness",
            "min": 0.7,
            "label": "70% of key pages refreshed in the window"
          }
        ]
      },
      "authority": {
        "3": [
          {
            "check": "bylines",
            "min": 0.8,
            "label": "bylines with Person schema on 80% of articles"
          }
        ],
        "4": [
          {
            "check": "same-as",
            "min": 1,
            "label": "Organization sameAs profiles"
          }
        ]
      },
      "measurement": {
        "3": [
