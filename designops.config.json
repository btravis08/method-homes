      "logo": "/method/brand/logo-nav.webp",
      "foundingDate": "2007",
      "foundingLocation": "Seattle, Washington",
      "sameAs": [],
      "areaServed": [
        "Washington",
        "Oregon",
        "California",
        "Idaho",
