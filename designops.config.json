    "prompts": [
      {
        "stage": "awareness",
        "text": "What is the difference between modular, prefab and manufactured homes?"
      },
      {
        "stage": "awareness",
        "text": "Is prefab construction higher quality than site-built for a custom home?"
      },
      {
        "stage": "awareness",
        "text": "How long does it take to build a prefab home from a predesigned series?"
      },
      {
        "stage": "consideration",
        "text": "Who are the best prefab and modular home builders in the Pacific Northwest?"
      },
      {
        "stage": "consideration",
        "text": "Which companies build architect-designed modular homes in Washington state?"
      },
      {
        "stage": "consideration",
        "text": "Best sustainable prefab home builders in the United States"
      },
      {
        "stage": "consideration",
        "text": "Method Homes vs Stillwater Dwellings vs Dvele — how do they compare?"
      },
      {
        "stage": "decision",
        "text": "What does a Method Homes prefab house cost?"
      },
      {
        "stage": "decision",
        "text": "Does Method Homes deliver to Oregon, Idaho or California, and what does site work add?"
      },
      {
        "stage": "retention",
        "text": "How do I maintain a modular home over its first ten years?"
      }
    ],
    "organization": {
