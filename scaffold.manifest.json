{
  "description": "Module ownership map and copier spec for the create-CLI scaffolder. The CLI copies the whole template minus 'site-specific' (and packs/); feature modules always ship as files \u2014 cross-module imports exist (SectionRenderer uses commerce card math, the library registry uses the legacy sections) \u2014 and runtime flags in designops.config.json gate what the Studio and site expose. Module lists below document which feature owns each file.",
  "base": [
    "designops.config.json",
    "scaffold.manifest.json",
    "AGENTS.md",
    "src/app/globals.css",
    "src/app/layout.tsx",
    "src/app/sitemap.ts",
    "src/app/(site)/layout.tsx",
    "src/app/(site)/page.tsx",
    "src/app/(site)/[slug]/**",
    "src/app/studio/**",
    "src/app/api/draft-mode/**",
    "src/app/api/revalidate/**",
    "src/components/Navigation.tsx",
    "src/components/SiteFooter.tsx",
    "src/components/PageTransition.tsx",
    "src/components/MotionProvider.tsx",
    "src/components/SmoothScroll.tsx",
    "src/components/home/**",
    "src/components/dev/**",
    "src/components/preview/**",
    "src/components/SectionRenderer.tsx",
    "src/sanity/env.ts",
    "src/sanity/lib/client.ts",
    "src/sanity/lib/fetch.ts",
    "src/sanity/lib/image.ts",
    "src/sanity/lib/redirects.ts",
    "src/sanity/schemaTypes/index.ts",
    "src/sanity/schemaTypes/page.ts",
    "src/sanity/schemaTypes/sections.ts",
    "src/sanity/schemaTypes/navigation.ts",
    "src/sanity/schemaTypes/siteSettings.ts",
    "src/sanity/schemaTypes/blockContent.ts",
    "src/sanity/schemaTypes/redirect.ts",
    "src/sanity/tools/**",
    "src/sanity/theme.ts",
    "src/library/**",
    "src/design/**",
    "src/fonts/**",
    "src/lib/**",
    "scripts/seed-pack.ts",
    "scripts/tokens.mjs",
    "scripts/collect-lighthouse.mjs",
    "scripts/audit-sections.mjs",
    "scripts/motion-specs.mjs",
    "scripts/check-design-drift.mjs",
    "scripts/lib/**",
    ".github/workflows/lighthouse-history.yml",
    ".github/workflows/audit.yml",
    ".github/workflows/design-drift.yml",
    ".github/workflows/check-links.yml",
    ".github/workflows/dataset-backup.yml",
    ".github/workflows/fetch-figma-assets.yml",
    "sanity.config.ts",
    "sanity.cli.ts",
    "src/app/robots.ts",
    "src/app/favicon.ico",
    "src/app/library/**",
    "src/app/api/forms/**",
    "src/app/api/gate/**",
    "src/app/api/ab/**",
    "src/components/AnnouncementBar.tsx",
    "src/components/FooterTagline.tsx",
    "src/components/LiveVisualEditing.tsx",
    "src/components/Logo.tsx",
    "src/components/MenuX.tsx",
    "src/components/NavTextLink.tsx",
    "src/components/NewsletterForm.tsx",
    "src/components/PageGate.tsx",
    "src/components/SmartLink.tsx",
    "src/components/icons.tsx",
    "src/components/navBackdrop.ts",
    "src/components/useMdUp.ts",
    "src/components/experiment/**",
    "src/sanity/components/**",
    "src/sanity/lib/queries.ts",
    "src/sanity/lib/seo.ts",
    "src/sanity/lib/preview-store.ts",
    "src/sanity/schemaTypes/formSubmission.ts",
    "src/sanity/schemaTypes/seo.ts",
    "src/sanity/types.ts",
    "scripts/build-token-index.mjs"
  ],
  "commerce": [
    "src/app/(site)/products/**",
    "src/app/(site)/collections/**",
    "src/app/api/search/**",
    "src/app/(site)/search/**",
    "src/components/cart/**",
    "src/components/product/**",
    "src/components/search/**",
    "src/sanity/lib/commerce.ts",
    "src/sanity/lib/cards.ts",
    "src/sanity/lib/search.ts",
    "src/sanity/schemaTypes/product.ts",
    "src/sanity/schemaTypes/collection.ts",
    "src/sanity/schemaTypes/discount.ts",
    "src/sanity/schemaTypes/story.ts",
    "src/sanity/schemaTypes/storeSettings.ts",
    "src/components/collection/**"
  ],
  "blog": [
    "src/app/(site)/journal/**",
    "src/components/journal/**",
    "src/sanity/schemaTypes/blog.ts"
  ],
  "projects": [
    "src/app/(site)/projects/**",
    "src/sanity/schemaTypes/project.ts",
    "src/components/ProjectCard.tsx"
  ],
  "packs": {
    "description": "Sample packs the create-CLI can copy into a scaffold as sample-pack/ (seeded by scripts/seed-pack.ts). The packs and the CLI itself live under packages/ and are never copied.",
    "paths": [
      "packages/create-sdr-site/**"
    ]
  },
  "site-specific": {
    "description": "SDR-only content that a scaffold replaces with a sample pack: never copied to new projects.",
    "paths": [
      "public/figma/**",
      "public/sdr/**",
      "design/sdr-catalog/**",
      "scripts/seed.ts",
      "scripts/import-sdr-catalog.ts",
      "scripts/fetch-sdr-catalog.mjs",
      "scripts/fetch-figma-assets.sh",
      "src/app/(site)/media-test/**",
      "scripts/retire-lorem.ts",
      "scripts/fix-catalog-ids.ts",
      "scripts/wire-nav-collections.ts",
      ".github/workflows/fetch-sdr-catalog.yml",
      ".github/workflows/capture-reference.yml",
      ".github/workflows/lighthouse.yml",
      ".github/workflows/probe.yml"
    ]
  },
  "site-example": {
    "description": "SDR-branded content that ships as a working example until the new project replaces it: the legacy page is the library's animation showcase, and the Figma token exports power the token tooling until re-exported from the project's own file.",
    "paths": [
      "src/app/(site)/legacy/**",
      "src/components/legacy/**",
      "src/sanity/schemaTypes/legacyPage.ts",
      "design/figma-tokens/**",
      "scripts/seed-legacy.ts"
    ]
  }
}
